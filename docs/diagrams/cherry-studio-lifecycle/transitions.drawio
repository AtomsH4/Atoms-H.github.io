  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="808" pageHeight="1136" math="1" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="三种能力，三个不同的问题" style="text;html=1;whiteSpace=wrap;labelBackgroundColor=none;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#37335f;fontSize=30;fontFamily=PingFang SC,Microsoft YaHei,sans-serif;align=left;verticalAlign=top;fontStyle=1" vertex="1" parent="1"><mxGeometry x="32" y="24" width="696" height="48" as="geometry"/></mxCell><mxCell id="3" value="确认需要 Lifecycle 后，只选择真实需要的能力" style="text;html=1;whiteSpace=wrap;labelBackgroundColor=none;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#62667f;fontSize=20;fontFamily=PingFang SC,Microsoft YaHei,sans-serif;align=left;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="32" y="80" width="696" height="40" as="geometry"/></mxCell><mxCell id="4" value="@Conditional · 整个服务是否存在" style="text;html=1;whiteSpace=wrap;labelBackgroundColor=none;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#37335f;fontSize=26;fontFamily=PingFang SC,Microsoft YaHei,sans-serif;align=left;verticalAlign=top;fontStyle=1" vertex="1" parent="1"><mxGeometry x="32" y="152" width="696" height="48" as="geometry"/></mxCell><mxCell id="5" value="启动时判断&lt;br&gt;会话内不变的条件" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#eeeaff;strokeColor=#8170c9;strokeWidth=1.5;fontColor=#37335f;fontSize=24;fontFamily=PingFang SC,Microsoft YaHei,sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="32" y="216" width="288" height="128" as="geometry"/></mxCell><mxCell id="6" value="成立：纳入服务&lt;br&gt;不成立：排除整个服务" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#eeeaff;strokeColor=#8170c9;strokeWidth=1.5;fontColor=#37335f;fontSize=23;fontFamily=PingFang SC,Microsoft YaHei,sans-serif;verticalAlign=middle;align=center" vertex="1" parent