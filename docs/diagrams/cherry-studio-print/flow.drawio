  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="848" pageHeight="1152" math="1" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="从当前内容到打印输出" style="text;html=1;whiteSpace=wrap;labelBackgroundColor=none;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#37335f;fontSize=30;fontFamily=PingFang SC,Microsoft YaHei,sans-serif;align=left;verticalAlign=top;fontStyle=1" vertex="1" parent="1"><mxGeometry x="32" y="24" width="544" height="48" as="geometry"/></mxCell><mxCell id="3" value="页面取内容，主进程编排，隐藏窗口承载排版" style="text;html=1;whiteSpace=wrap;labelBackgroundColor=none;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#62667f;fontSize=22;fontFamily=PingFang SC,Microsoft YaHei,sans-serif;align=left;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="32" y="80" width="696" height="40" as="geometry"/></mxCell><mxCell id="4" value="笔记页面与编辑器&lt;br&gt;读取当前值&lt;br&gt;空内容提示并结束" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#eeeaff;strokeColor=#8170c9;strokeWidth=1.5;fontColor=#37335f;fontSize=23;fontFamily=PingFang SC,Microsoft YaHei,sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="32" y="168" width="336" height="120" as="geometry"/></mxCell><mxCell id="5" value="类型化 IPC 请求&lt;br&gt;当前 title / markdown&lt;br&gt;可选 sourcePath" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#eeeaff;strokeColor=#8170c9;strokeWidth=1.5;fontColor=#37335f;fontSize=22;fontFamily=PingFang SC,Microsoft YaHei,sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="456" y="168" width="312" height="120" as="geometry"/></mxCell><mxCell id="6" value="主进程 PrintService&lt;br&gt;生成 HTML&lt;br&gt;编排打印与导出" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#e7f3fa;strokeColor=#5495b9;strokeWidth=1.5;fontColor=#254e68;fontSize=22;fontFamily=PingFang SC,Microsoft YaHei,