  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="752" pageHeight="1056" math="1" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="原子性止于数据库事务边界" style="text;html=1;whiteSpace=wrap;labelBackgroundColor=none;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#37335f;fontSize=30;fontFamily=PingFang SC,Microsoft YaHei,sans-serif;align=left;verticalAlign=top;fontStyle=1" vertex="1" parent="1"><mxGeometry x="32" y="24" width="640" height="48" as="geometry"/></mxCell><mxCell id="3" value="提交之后，靠重试与对账恢复一致" style="text;html=1;whiteSpace=wrap;labelBackgroundColor=none;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#62667f;fontSize=22;fontFamily=PingFang SC,Microsoft YaHei,sans-serif;align=left;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="32" y="80" width="640" height="40" as="geometry"/></mxCell><mxCell id="4" value="命令准备&lt;br&gt;取得锁，检查守卫条件" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#eeeaff;strokeColor=#8170c9;strokeWidth=1.5;fontColor=#37335f;fontSize=23;fontFamily=PingFang SC,Microsoft YaHei,sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="240" y="152" width="400" height="88" as="geometry"/></mxCell><mxCell id="5" value="单个同步数据库事务&lt;br&gt;实体 + 选中关联对象&lt;br&gt;+ 调度状态" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#e7f3fa;strokeColor=#5495b9;strokeWidth=1.5;fontColor=#254e68;fontSize=24;fontFamily=PingFang SC,Microsoft YaHei,sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="240" y="312" width="400" height="128" as="geometry"/></mxCell><mxCell id="6" value="提交前异常&lt;br&gt;整组数据回滚" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fff2df;strokeColor=#ba8850;strokeWidth=1.5;fontColor=#785324;fontSize=21;fontFamily=PingFang SC,Microsoft YaHei,sans-serif;verticalAlign=middle;align=center" vertex="1" parent="