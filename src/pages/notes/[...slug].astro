---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import PageHero from '../../components/PageHero.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedEntries } from '../../lib/content';

export async function getStaticPaths() {
  const entries = getPublishedEntries(await getCollection('notes'));

  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props as { entry: CollectionEntry<'notes'> };
const { Content } = await render(entry);
---

<BaseLayout title={`${entry.data.title} | AtomsH4`}>
  <PageHero
    eyebrow="Notes"
    title={entry.data.title}
    description={entry.data.summary}
  />
  <article class="prose notes-article">
    <Content />
  </article>
</BaseLayout>

<style>
  :global(main:has(> .notes-article)) {
    min-width: 0;
  }

  .notes-article {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .prose :global(pre) {
    max-width: 100%;
    overflow-x: auto;
    padding: var(--space-4);
    border-radius: var(--radius-md);
    font-size: 0.875em;
    line-height: 1.6;
  }

  .prose :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
  }

  .prose :global(a) {
    color: var(--color-accent-deep);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
</style>
