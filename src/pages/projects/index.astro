---
import { getCollection } from 'astro:content';
import EntryList from '../../components/EntryList.astro';
import PageHero from '../../components/PageHero.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedEntries } from '../../lib/content';

const entries = getPublishedEntries(await getCollection('projects'));
---

<BaseLayout title="项目 | AtomsH4">
  <PageHero
    eyebrow="Projects"
    title="项目"
    description="收录正在实践、维护或学习中的公开项目。"
  />
  <section class="content-section" aria-label="项目列表">
    <EntryList entries={entries} emptyMessage="项目正在整理中。" collection="projects" />
  </section>
</BaseLayout>
